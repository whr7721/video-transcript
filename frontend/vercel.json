{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev:preview",
  "rewrites": [
    {
      "source": "/studio/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/studio/:path*",
      "destination": "/index.html"
    }
  ]
}
